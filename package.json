{
  "name": "awesome-minimax-h3-cases",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-runtime-data.mjs && node scripts/build-poster-variants.mjs && vite",
    "build": "node scripts/sync-creators.mjs && node scripts/sync-project-stats.mjs && node scripts/build-discovery-files.mjs && node scripts/build-runtime-data.mjs && node scripts/build-poster-variants.mjs && tsc -b && vite build && node scripts/build-seo-pages.mjs",
    "start": "node scripts/serve-static.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "pretest": "node scripts/build-runtime-data.mjs",
    "test": "vitest run",
    "classify": "node scripts/classify-candidates.mjs",
    "review:video": "node scripts/review-video.mjs",
    "mirror:videos": "node scripts/mirror-videos.mjs",
    "videos:playback:audit": "node scripts/migrate-playback-videos.mjs",
    "videos:playback:migrate": "node scripts/migrate-playback-videos.mjs",
    "videos:playback:verify": "node scripts/migrate-playback-videos.mjs --verify-only",
    "videos:faststart:official": "node scripts/faststart-official-videos.mjs",
    "promote": "node scripts/promote-candidates.mjs",
    "commit:staged": "node scripts/commit-staged-cases.mjs",
    "cost": "node scripts/estimate-cost.mjs",
    "privacy:scan": "node scripts/privacy-scan.mjs",
    "validate:data": "node scripts/privacy-scan.mjs && node scripts/validate-data.mjs && node scripts/sync-creators.mjs && node scripts/sync-project-stats.mjs",
    "sync:creators": "node scripts/sync-creators.mjs --write",
    "check:creators": "node scripts/sync-creators.mjs",
    "sync:stats": "node scripts/sync-creators.mjs --write && node scripts/sync-project-stats.mjs --write",
    "sync:github": "node scripts/sync-github-metadata.mjs --write",
    "sync:resource-metrics": "node scripts/sync-resource-metrics.mjs --write",
    "catalog": "node scripts/build-catalog.mjs",
    "runtime:data": "node scripts/build-runtime-data.mjs",
    "posters:webp": "node scripts/build-poster-variants.mjs",
    "performance:budget": "node scripts/check-performance-budgets.mjs",
    "performance:browser": "node scripts/performance-smoke.mjs",
    "readme:build-metrics": "node scripts/sync-readme-build-metrics.mjs --write",
    "readme:check": "node scripts/sync-readme-build-metrics.mjs",
    "discovery": "node scripts/build-discovery-files.mjs",
    "sync:external": "node scripts/sync-external-catalog.mjs",
    "tutorials:check": "node scripts/tutorial-collection.mjs",
    "tutorials:publish": "node scripts/tutorial-collection.mjs --publish",
    "skills:verify": "node scripts/verify-skills.mjs",
    "skills:install": "npx skills add . --skill minimax-h3-prompt-library minimax-h3-tutorial-guide --agent codex claude-code",
    "screenshots:capture": "npm run readme:build-metrics && node scripts/capture-readme-screenshots.mjs && npm run readme:check",
    "screenshots": "npm run build && npm run screenshots:capture",
    "seo": "node scripts/build-seo-pages.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@smithy/node-http-handler": "4.10.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
