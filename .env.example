# Xiaomi MiMo Token Plan. Keep this file blank in Git and put real values only in
# your local .env or a sealed deployment secret.
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_AUTH_SCHEME=bearer
# Text extraction and taxonomy.
MIMO_TEXT_MODEL=mimo-v2.5-pro
# Native video/audio review. The Pro route is text-only in the current plan.
MIMO_MODEL=mimo-v2.5
# Umami analytics. Leave blank to disable tracking; real values live on the
# Railway site service so production builds embed the tracker.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
