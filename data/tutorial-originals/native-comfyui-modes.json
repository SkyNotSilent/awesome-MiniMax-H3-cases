            {
              "t": "Prompting tips"
            }
          ]
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Keyframes"
                },
                {
                  "t": ": The "
                },
                {
                  "c": true,
                  "t": "first_frame"
                },
                {
                  "t": " and "
                },
                {
                  "c": true,
                  "t": "last_frame"
                },
                {
                  "t": " inputs are optional; the model generates the motion between them"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Prompt"
                },
                {
                  "t": ": Describe the shots, motion, and the accompanying audio (dialogue, SFX, music) in one block"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Resolution"
                },
                {
                  "t": ": H3's native canvas is a 768px short edge, which is 1344x768 at 16:9, and resolutions are rounded to a multiple of 32"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Duration"
                },
                {
                  "t": ": The duration input snaps to the model's 17-frame-per-block (17k+5) grid at 24fps"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Turbo mode"
                },
                {
                  "t": ": Enable "
                },
                {
                  "c": true,
                  "t": "turbo_mode"
                },
                {
                  "t": " on the MiniMax H3 node to switch to the turbo LoRA and generate in "
                },
                {
                  "c": true,
                  "t": "turbo_steps"
                },
                {
                  "t": " (default 8) instead of 20 steps. "
                },
                {
                  "c": true,
                  "t": "turbo_model_strength"
                },
                {
                  "t": " controls the LoRA strength (default 1.0)."
                }
              ]
            }
