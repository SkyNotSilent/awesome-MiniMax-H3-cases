      "blocks": [
        {
          "type": "quote",
          "inlines": [
            {
              "t": "Run ComfyUI workflows online with Comfy Cloud, the official cloud platform powered by NVIDIA RTX 6000 Pro GPUs. No local installation required."
            }
          ]
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            {
              "depth": 0,
              "inlines": [
                {
                  "href": "https://comfy.org/cloud",
                  "b": true,
                  "t": "Access Comfy Cloud"
                },
                {
                  "t": " — Click here to access ComfyUI Cloud directly"
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "level": 3,
          "inlines": [
            {
              "t": "What is Comfy Cloud?"
            }
          ]
        },
        {
          "type": "paragraph",
          "inlines": [
            {
              "t": "ComfyUI Cloud is the cloud version of ComfyUI with the same features as the local version. Everything is pre-installed and ready to use."
            }
          ]
        },
        {
          "type": "heading",
          "level": 4,
          "inlines": [
            {
              "t": "Key features"
            }
          ]
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Zero setup"
                },
                {
                  "t": " — No installation required. All models and custom nodes are pre-installed and ready to use"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Powerful GPUs"
                },
                {
                  "t": " — Run workflows fast on our powerful server GPUs without needing your own hardware"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Always up-to-date"
                },
                {
                  "t": " — Automatically stays current with the latest ComfyUI releases and features"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Access anywhere"
                },
                {
                  "t": " — Use ComfyUI from any device with an internet connection - no local installation needed"
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "level": 3,
          "inlines": [
            {
              "t": "Cloud vs local"
            }
          ]
        },
        {
          "type": "paragraph",
          "inlines": [
            {
              "t": "ComfyUI offers both an official cloud version, "
            },
            {
              "href": "https://comfy.org/cloud",
              "t": "Comfy Cloud"
            },
            {
              "t": ", and an open-source self-hosted version. If you have a powerful GPU, running ComfyUI locally is a great option. The cloud version, on the other hand, is an online service that's ready to use instantly—simply open the URL, no installation or setup required."
            }
          ]
        },
