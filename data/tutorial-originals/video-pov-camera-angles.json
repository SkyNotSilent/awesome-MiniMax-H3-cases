        },
        {
          "type": "heading",
          "level": 4,
          "inlines": [
            {
              "t": "Prompting tips"
            }
          ]
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Reference by tag"
                },
                {
                  "t": ": Reference each input by tag in the exact order it was connected, for example "
                },
                {
                  "c": true,
                  "t": ", "
                },
                {
                  "t": ", ``"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Assign each reference a job"
                },
                {
                  "t": ": State which reference drives which part of the shot (identity, style, motion, camera, voice). Explicit assignments tend to work much better"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Limits"
                },
                {
                  "t": ": Up to 9 reference images, 3 reference videos (each can carry its own soundtrack), and 3 standalone reference audio clips"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "ref_image_size"
                },
                {
                  "t": ": "
                },
                {
                  "c": true,
                  "t": "match"
                },
                {
                  "t": " scales references down to the generation resolution for speed; "
                },
                {
                  "c": true,
                  "t": "max"
                },
                {
                  "t": " keeps up to a 2048px short edge for stronger identity fidelity at the cost of speed"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Note"
                },
                {
                  "t": ": R2V uses the "
                },
                {
                  "c": true,
                  "t": "ref2va"
                },
                {
                  "t": " diffusion model, a different set of weights from the "
                },
                {
                  "c": true,
                  "t": "fl2va"
                },
                {
                  "t": " model used by the T2V and I2V workflows"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "b": true,
                  "t": "Turbo mode (optional)"
                },
                {
                  "t": ": The workflow generates at 20 steps by default; raise the step count (for example to 25) for better motion quality. Enable the "
                },
                {
                  "b": true,
                  "t": "Lightning LoRA"
                },
                {
                  "t": " checkbox to use the 4-step turbo LoRA ("
                },
                {
                  "c": true,
                  "t": "minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16"
                },
                {
                  "t": ") for much faster generation, with slightly lower audio and motion quality"
                }
              ]
            }
          ]
        },
