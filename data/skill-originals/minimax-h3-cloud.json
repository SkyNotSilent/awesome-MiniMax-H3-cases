                }
              ]
            ],
            [
              [
                {
                  "t": "1.0MP"
                }
              ],
              [
                {
                  "t": "1376×768"
                }
              ],
              [
                {
                  "t": "约 768P，横向略宽"
                }
              ]
            ]
          ]
        },
        {
          "type": "paragraph",
          "inlines": [
            {
              "t": "用户明确写 "
            },
            {
              "c": true,
              "t": "480P"
            },
            {
              "t": "、"
            },
            {
              "c": true,
              "t": "720P"
            },
            {
              "t": " 或 "
            },
            {
              "c": true,
              "t": "768P"
            },
            {
              "t": " 时，可以结合画幅按上表转换；转换前用一句话告知对应 MP。旧的 "
            },
            {
              "c": true,
              "t": "preview"
            },
            {
              "t": "、"
            },
            {
              "c": true,
              "t": "balanced"
            },
            {
              "t": "、"
            },
            {
              "c": true,
              "t": "short_hq"
            },
            {
              "t": " 只保留为内部兼容快捷方式，不作为用户必选步骤。64GB Runtime 不运行 15 秒 0.9MP 或更高配置。"
            }
          ]
        },
        {
          "type": "heading",
          "level": 3,
          "inlines": [
            {
              "t": "操作"
            }
          ]
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            {
              "depth": 0,
              "inlines": [
                {
                  "t": "首次配置时直接说明当前使用优云智算，并只提供两个可点击入口："
                },
                {
                  "href": "https://console.compshare.cn/",
                  "t": "注册或登录"
                },
                {
                  "t": "、"
                },
                {
                  "href": "https://console.compshare.cn/uaccount/api_manage",
                  "t": "创建或管理 API Key"
                },
                {
                  "t": "。同时用一句话提示 MiniMax H3 受"
                },
                {
                  "href": "https://huggingface.co/MiniMaxAI/MiniMax-H3/blob/main/LICENSE",
                  "t": "社区许可证"
                },
                {
                  "t": "及地域限制约束；不要单独显示欢迎页、平台选择页或“未来将支持更多平台”文案。"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "t": "如果本机尚无隔离凭证配置，让用户自行在终端运行 "
                },
                {
                  "c": true,
                  "t": "compshare config set --name <隔离名称> --no-activate"
                },
                {
                  "t": "，通过官方隐藏输入录入 API Key。插件不得读取或回显密钥。提醒用户不要把 API Key 发到对话中，并请他完成后只回复“已完成”；随后立即结束当前回合。这个结束点是硬性边界，不得继续展示 GPU 配置页、生成模式、参数示例、费用说明或索要提示词。下一回合先验证凭证，成功时只简短报告“优云智算已连接”，再进入第 3 步。"
                }
              ]
            },
            {
              "depth": 0,
              "inlines": [
                {
                  "t": "凭证成功后运行 "
                },
                {
                  "c": true,
                  "t": "scripts/h3-onboard options --platform compshare --credential-profile <隔离名称>"
                },
                {
                  "t": "。优先使用 "
                },
                {
                  "c": true,
                  "t": "request_user_input"
                },
                {
                  "t": " 向用户展示一个 GPU 单选题，三个返回项按原顺序作为三个选项；选项描述合并 "
                },
                {
                  "c": true,
                  "t": "priceDisplay"
                },
                {
                  "t": "、"
                },
                {
                  "c": true,
