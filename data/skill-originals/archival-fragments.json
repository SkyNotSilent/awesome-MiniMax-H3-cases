              "b": true,
              "t": "三个必须停下来问用户的节点"
            },
            {
              "t": "："
            }
          ]
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            {
              "depth": 0,
              "inlines": [
                {
                  "t": "阶段 0 检查完 —— 告诉用户环境就绪，请他给想法或文案"
