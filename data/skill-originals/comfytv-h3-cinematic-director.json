{
  "skillId": "comfytv-h3-cinematic-director",
  "kind": "markdown",
  "title": "h3-cinematic-director",
  "language": "en",
  "capturedAt": "2026-09-13T11:12:12.107Z",
  "source": {
    "url": "https://github.com/jtydhr88/ComfyTV",
