{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "H3 Field Notes case",
  "type": "object",
  "required": [
    "id", "title", "titleEn", "summary", "summaryEn", "model", "mode", "prompt", "sourceUrl", "author", "posterUrl",
    "category", "styles", "scenes", "inputTypes", "promptProvenance", "verified"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "title": { "type": "string" },
    "titleEn": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "summaryEn": { "type": "string", "minLength": 1 },
    "model": { "type": "string" },
    "mode": { "enum": ["T2VA", "FL2VA", "Ref2VA", "Unknown"] },
    "prompt": { "type": ["string", "null"], "minLength": 1 },
    "sourceUrl": { "type": "string", "format": "uri" },
    "posterUrl": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "category": { "type": "string" },
    "styles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "scenes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "inputTypes": {
      "type": "array",
      "items": { "enum": ["text", "image", "video", "audio", "unknown"] },
      "uniqueItems": true
    },
    "promptProvenance": {
      "enum": ["official-verbatim", "creator-verbatim", "not-published"]
    },
    "verified": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "promptProvenance": { "const": "not-published" } },
        "required": ["promptProvenance"]
      },
      "then": { "properties": { "prompt": { "type": "null" } } },
      "else": { "properties": { "prompt": { "type": "string", "minLength": 1 } } }
    }
  ]
}
